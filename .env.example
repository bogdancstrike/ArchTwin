# Create .env with every internal secret generated:   ./scripts/init-env.sh sk-your-openai-key
# Only OPENAI_API_KEY is user-supplied, and only LiteLLM receives it.
OPENAI_API_KEY=sk-...
# litellm (real models through the gateway) | fake (deterministic, zero tokens; used by CI)
ARCHTWIN_LLM_MODE=litellm

POSTGRES_PASSWORD=change-me
ARCHTWIN_APP_DB_PASSWORD=change-me
KEYCLOAK_ADMIN_PASSWORD=change-me
# 32-byte base64 key-encryption key for connector secrets (envelope encryption, dev KeyProvider)
ARCHTWIN_KEK=change-me
LITELLM_MASTER_KEY=change-me
LITELLM_UI_PASSWORD=admin
LANGFUSE_PUBLIC_KEY=change-me
LANGFUSE_SECRET_KEY=change-me
LANGFUSE_NEXTAUTH_SECRET=change-me
LANGFUSE_SALT=change-me
LANGFUSE_ENCRYPTION_KEY=change-me
LANGFUSE_ADMIN_PASSWORD=change-me
ARCHTWIN_ADMIN_EMAIL=admin@archtwin.local
CLICKHOUSE_PASSWORD=change-me
VALKEY_PASSWORD=change-me
SEAWEED_ACCESS_KEY=change-me
SEAWEED_SECRET_KEY=change-me

# Source repositories mounted read-only into the worker for the local git connector (/sources/<name>)
ARCHTWIN_SOURCE_HORIZON=../horizon
# Host directory (ABSOLUTE path) with your local sources, mounted read-only at the same path. It is the outer boundary:
# admins whitelist folders inside it in System › Source roots (default: all of it). Any whitelisted folder can then be
# added as a "Local directory" datasource using its host path (one repo, a folder of repos, docs, architecture, ...)
ARCHTWIN_SOURCE_WORKSPACE=
# Self-hosted GitLab / Taiga / ... on private addresses (10.x, 172.16-31.x, 192.168.x) must be allow-listed (comma list)
ARCHTWIN_EGRESS_ALLOW_PRIVATE_HOSTS=
# Hosts whose TLS certificate is NOT verified (self-signed / wrong CN). Operator decision; keep empty when possible.
ARCHTWIN_EGRESS_INSECURE_TLS_HOSTS=
# Token prices (USD per 1M tokens) for models without a built-in price: {"gpt-6-sol": [input, cached_input, output]}
ARCHTWIN_LLM_PRICES=

# Host ports (chosen to coexist with a Horizon stack)
WEB_PORT=3200
KEYCLOAK_PORT=8280
API_PORT=8200
POSTGRES_PORT=5452
LITELLM_PORT=4200
LANGFUSE_PORT=3201
TEMPORAL_UI_PORT=8253
ARCHTWIN_LOG_LEVEL=info
# optional profiles: documents (docling-serve)
COMPOSE_PROFILES=
