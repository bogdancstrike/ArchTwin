{
 "realm": "archtwin",
 "enabled": true,
 "registrationAllowed": false,
 "sslRequired": "none",
 "accessTokenLifespan": 900,
 "ssoSessionIdleTimeout": 28800,
 "ssoSessionMaxLifespan": 86400,
 "roles": {
  "realm": [
   {
    "name": "platform_admin",
    "description": "Seeded as owner of the demo organization"
   },
   {
    "name": "architect"
   },
   {
    "name": "reviewer"
   },
   {
    "name": "viewer"
   }
  ]
 },
 "clients": [
  {
   "clientId": "archtwin-web",
   "name": "ArchTwin web",
   "publicClient": true,
   "standardFlowEnabled": true,
   "directAccessGrantsEnabled": false,
   "redirectUris": [
    "http://localhost:3200/*"
   ],
   "webOrigins": [
    "http://localhost:3200"
   ],
   "attributes": {
    "pkce.code.challenge.method": "S256",
    "post.logout.redirect.uris": "http://localhost:3200/*"
   },
   "protocolMappers": [
    {
     "name": "audience-archtwin-api",
     "protocol": "openid-connect",
     "protocolMapper": "oidc-audience-mapper",
     "config": {
      "included.custom.audience": "archtwin-api",
      "access.token.claim": "true",
      "id.token.claim": "false"
     }
    }
   ]
  },
  {
   "clientId": "archtwin-cli",
   "name": "ArchTwin CLI / e2e tests (dev only)",
   "publicClient": true,
   "standardFlowEnabled": false,
   "directAccessGrantsEnabled": true,
   "protocolMappers": [
    {
     "name": "audience-archtwin-api",
     "protocol": "openid-connect",
     "protocolMapper": "oidc-audience-mapper",
     "config": {
      "included.custom.audience": "archtwin-api",
      "access.token.claim": "true",
      "id.token.claim": "false"
     }
    }
   ]
  }
 ],
 "users": [
